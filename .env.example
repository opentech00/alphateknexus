# Supabase (client) - required for local dev
# Copy this file to `.env` and populate real values (DO NOT COMMIT `.env`)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Supabase (server) - service role (keep secret, do NOT commit real key)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Example additional variables
DATABASE_URL=postgresql://user:pass@localhost:5432/dbname
# Supabase project ref (not secret)
SUPABASE_PROJECT_REF=your_project_ref
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Mapbox (public token — restrict by URL in the Mapbox dashboard)
# Used for maps in the client, field, and admin apps.
# Also set MAPBOX_ACCESS_TOKEN as a Supabase Edge Function secret for geocoding/directions.
VITE_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token