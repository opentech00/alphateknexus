# Copy this file to `.env` and populate real values. Never commit `.env`.

# --- Supabase (client, baked into the Vite bundle) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Optional alias for the new publishable key name. Falls back to VITE_SUPABASE_ANON_KEY.
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# --- Supabase (server only — never add to Vercel or VITE_*) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_REF=your_project_ref

# --- Mapbox (public token — restrict by URL in the Mapbox dashboard) ---
# Client maps use this. Also set MAPBOX_ACCESS_TOKEN as a Supabase Edge Function secret.
VITE_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token

# --- Monime.io — set these as Supabase Edge Function secrets only ---
# Dashboard → Edge Functions → Secrets. Never VITE_* / never Vercel.
# MONIME_ACCESS_KEY=your-monime-access-key
# MONIME_SPACE_ID=spc-your-space-id
# MONIME_WEBHOOK_SECRET=your-webhook-hmac-secret
# Webhook URL: https://<your-project-ref>.supabase.co/functions/v1/monime-webhook

# --- WhatsApp Cloud API (signup OTP) — Edge Function secrets only, never VITE_* ---
# WHATSAPP_TOKEN=EAAB...
# WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# WHATSAPP_TEMPLATE_NAME=alphatek_otp
# WHATSAPP_TEMPLATE_LANG=en
# Optional: WHATSAPP_TEMPLATE_BUTTON=0  (skip copy-code/url button if the template has body only)
# PHONE_OTP_PEPPER=long-random-string
